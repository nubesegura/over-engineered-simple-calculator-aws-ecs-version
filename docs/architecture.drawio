<mxfile host="app.diagrams.net"><diagram id="ecs-architecture" name="ECS architecture"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ECS version of the calculator - one environment (dev or prod). Numbers refer to the legend below." style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="4" width="900" height="24" as="geometry"/></mxCell><mxCell id="browser" value="Browser: web page" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="160" height="60" as="geometry"/></mxCell><mxCell id="g1" value="Owned by the webpage repository" style="rounded=1;fillColor=none;html=1;fontSize=12;dashed=1;strokeColor=#666666;verticalAlign=bottom;align=center;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="215" width="180" height="285" as="geometry"/></mxCell><mxCell id="r53" value="Route 53 weights" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#8C4FFF;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="1"><mxGeometry x="75" y="245" width="50" height="50" as="geometry"/></mxCell><mxCell id="acm" value="API certificate (ACM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="160" height="40" as="geometry"/></mxCell><mxCell id="cog" value="Cognito" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#DD344C;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="75" y="405" width="50" height="50" as="geometry"/></mxCell><mxCell id="gh" value="GitHub Actions (OIDC): build, push to ECR, migrate, apply" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="180" height="80" as="geometry"/></mxCell><mxCell id="aws" value="AWS account, us-east-2 (one per environment)" style="rounded=1;fillColor=none;html=1;fontSize=12;strokeColor=#232F3E;verticalAlign=top;align=right;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="230" y="40" width="1250" height="780" as="geometry"/></mxCell><mxCell id="vpc" value="VPC, two availability zones" style="rounded=1;fillColor=none;html=1;fontSize=12;strokeColor=#248814;verticalAlign=bottom;align=right;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="790" height="720" as="geometry"/></mxCell><mxCell id="pub" value="Public subnets" style="rounded=1;fillColor=none;html=1;fontSize=12;fillColor=#f0f8ee;strokeColor=#7aa116;verticalAlign=bottom;align=right;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="270" y="100" width="750" height="150" as="geometry"/></mxCell><mxCell id="alb" value="ALB" style="outlineConnect=0;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.aws3.application_load_balancer;fillColor=#F58534;gradientColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="125" width="60" height="62" as="geometry"/></mxCell><mxCell id="waf" value="WAF (prod only)" style="outlineConnect=0;dashed=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.aws3.waf;fillColor=#759C3E;gradientColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="125" width="44" height="52" as="geometry"/></mxCell><mxCell id="nat" value="NAT gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=middle;labelPosition=left;verticalAlign=middle;align=right;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.nat_gateway;" vertex="1" parent="1"><mxGeometry x="900" y="125" width="50" height="50" as="geometry"/></mxCell><mxCell id="priv" value="Private subnets" style="rounded=1;fillColor=none;html=1;fontSize=12;fillColor=#eef3fb;strokeColor=#6c8ebf;verticalAlign=bottom;align=right;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="270" y="280" width="750" height="490" as="geometry"/></mxCell><mxCell id="cluster" value="ECS Fargate: five services, one task each, no public IP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fde9d9;strokeColor=#ED7100;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="290" y="310" width="710" height="140" as="geometry"/></mxCell><mxCell id="s0" value="calc-add" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ED7100;fontColor=#ffffff;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="305" y="365" width="110" height="45" as="geometry"/></mxCell><mxCell id="s1" value="calc-sub" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ED7100;fontColor=#ffffff;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="430" y="365" width="110" height="45" as="geometry"/></mxCell><mxCell id="s2" value="calc-mul" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ED7100;fontColor=#ffffff;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="555" y="365" width="110" height="45" as="geometry"/></mxCell><mxCell id="s3" value="calc-div" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ED7100;fontColor=#ffffff;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="680" y="365" width="110" height="45" as="geometry"/></mxCell><mxCell id="s4" value="history" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ED7100;fontColor=#ffffff;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="805" y="365" width="110" height="45" as="geometry"/></mxCell><mxCell id="jobs" value="Jobs: ingest (per CSV file) and migrate (from the pipeline)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fde9d9;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="290" y="600" width="210" height="70" as="geometry"/></mxCell><mxCell id="rds" value="RDS PostgreSQL" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#C925D1;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="860" y="520" width="60" height="60" as="geometry"/></mxCell><mxCell id="rc" value="Regional AWS services" style="rounded=1;fillColor=none;html=1;fontSize=12;fillColor=#fafafa;strokeColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="70" width="395" height="720" as="geometry"/></mxCell><mxCell id="sch" value="EventBridge Scheduler + Lambda: NAT on at 08:00, off at 22:00" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fad7e8;strokeColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="170" height="80" as="geometry"/></mxCell><mxCell id="ecr" value="ECR" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="1290" y="115" width="50" height="50" as="geometry"/></mxCell><mxCell id="sns" value="SNS" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="1390" y="115" width="50" height="50" as="geometry"/></mxCell><mxCell id="sm" value="Secrets Manager" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#DD344C;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="1090" y="260" width="50" height="50" as="geometry"/></mxCell><mxCell id="kms" value="KMS key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1210" y="265" width="90" height="40" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch: logs and alarms" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fad7e8;strokeColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1320" y="260" width="125" height="60" as="geometry"/></mxCell><mxCell id="s3log" value="S3 ALB logs" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket;" vertex="1" parent="1"><mxGeometry x="1090" y="430" width="48" height="50" as="geometry"/></mxCell><mxCell id="ssm" value="SSM: published target" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1210" y="430" width="150" height="45" as="geometry"/></mxCell><mxCell id="s3in" value="S3 ingestion" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket;" vertex="1" parent="1"><mxGeometry x="1090" y="600" width="48" height="50" as="geometry"/></mxCell><mxCell id="evb" value="EventBridge rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fad7e8;strokeColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1240" y="600" width="170" height="60" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="browser" target="r53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="browser" target="alb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="60"/></Array></mxGeometry></mxCell><mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0;exitY=0.6;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="alb" target="cog"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="162"/><mxPoint x="215" y="430"/></Array></mxGeometry></mxCell><mxCell id="e4" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.95;exitY=1;entryX=0.094;entryY=0;" edge="1" parent="1" source="alb" target="cluster"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.845;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cluster" target="rds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="jobs" target="rds"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="395" y="550"/></Array></mxGeometry></mxCell><mxCell id="e7" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.894;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cluster" target="nat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.5;exitY=0;entryX=0;entryY=0.035;" edge="1" parent="1" source="nat" target="rc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="925" y="95"/></Array></mxGeometry></mxCell><mxCell id="e9" value="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="sch" target="nat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3in" target="evb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="evb" target="jobs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1325" y="740"/><mxPoint x="395" y="740"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Flows&lt;/b&gt;&lt;br&gt;1 DNS by weights: Route 53 sends the API host name to one backend (sls, ecs, later others).&amp;nbsp;&amp;nbsp;2 HTTPS with the bearer ID token.&amp;nbsp;&amp;nbsp;3 The ALB verifies the token against the Cognito signing keys (JWKS, HTTPS 443 from the ALB group).&lt;br&gt;4 HTTPS to the tasks (self-signed certificate inside the VPC).&amp;nbsp;&amp;nbsp;5 PostgreSQL over TLS with the application user.&amp;nbsp;&amp;nbsp;6 The jobs use the same database.&lt;br&gt;7 Tasks and jobs reach AWS services through the NAT gateway.&amp;nbsp;&amp;nbsp;8 Egress to ECR, Secrets Manager, SNS and CloudWatch Logs.&amp;nbsp;&amp;nbsp;9 The scheduler creates the NAT at 08:00 and removes it at 22:00 (Panama time).&lt;br&gt;10 A new CSV in the ingestion bucket raises an event.&amp;nbsp;&amp;nbsp;11 The event starts the ingest job (no queue).&lt;br&gt;&lt;br&gt;&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;ALB: HTTPS 443, TLS 1.3/1.2 policy (ELBSecurityPolicy-TLS13-1-2-2021-06), JWT verification on every API path, preflight without token, 301 on port 80, access logs to S3; the shared WAF ACL is associated in prod only. Dashed box: owned by the webpage repository (certificate, weighted records, Cognito). RDS: db.t4g.micro, Single-AZ, KMS key, backups 1 day (dev) and 15 days (prod), credential in Secrets Manager rotated every 3 days (alternating application users). The rotation Lambda runs in the private subnets with the job security group and an S3 gateway endpoint serves the buckets; the ALB 5XX alarm fires at 5 or more in 5 minutes. GitHub Actions builds and pushes the images, runs the migration and applies the infrastructure." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=6;strokeColor=#bbbbbb;rounded=0;" vertex="1" parent="1"><mxGeometry x="250" y="835" width="1205" height="185" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
